+package com.leaf.skiller.client;
+
+import com.leaf.skiller.AllKeys;
+
+/**
+ * Abstraction over the key bindings that drive the skill slots on the client.
+ * 客户端技能槽位按键绑定的抽象。
+ * <p>
+ * A consuming mod implements this interface to supply its own key bindings instead of the
+ * ones Skiller ships with. The default behaviour — used while no source has been installed,
+ * see {@link ClientSkillCache#setKeySource(SkillKeySource)} — is to read
+ * {@link AllKeys#SKILL_KEYS}.
+ * 消费方模组实现此接口以提供自己的按键绑定，取代 Skiller 自带的键位。
+ * 默认行为（尚未安装来源时，见 {@link ClientSkillCache#setKeySource(SkillKeySource)}）
+ * 是读取 {@link AllKeys#SKILL_KEYS}。
+ * </p>
+ * <p>
+ * Implementations must treat a slot index outside their own range as "not pressed"
+ * instead of throwing, because the monitored slot set is derived from the consuming mod's
+ * own skill bindings and may not line up with the built-in key array.
+ * 实现方必须把超出自身范围的槽位索引视为"未按下"而不是抛异常 —— 受监控的槽位集合
+ * 来自消费方自己的技能绑定，未必与内置按键数组一一对应。
+ * </p>
+ *
+ * @see ClientSkillCache#setKeySource(SkillKeySource)
+ * @see ClientSkillCache#onKeyInput()
+ * @since 1.0.0
+ */
+@FunctionalInterface
+public interface SkillKeySource {
+
+    /**
+     * Checks whether the key bound to the given skill slot is currently held down.
+     * 检查给定技能槽位对应的按键当前是否被按下。
+     *
+     * @param slot The skill slot index to query
+     *             要查询的技能槽位索引
+     * @return {@code true} if the key bound to this slot is currently down; slot indexes
+     *         outside the implementation's own range must return {@code false}
+     *         如果该槽位绑定的按键当前按下则返回 {@code true}；
+     *         超出实现自身范围的槽位索引必须返回 {@code false}
+     * @since 1.0.0
+     */
+    boolean isDown(int slot);
+}
